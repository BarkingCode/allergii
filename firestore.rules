rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing user rules (keep existing patterns)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /data/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Conversations - device-based access (no auth required)
    // In production, add rate limiting via Cloud Functions
    match /conversations/{deviceId} {
      // Allow read/write if the request contains the matching deviceId
      allow read, write: if true; // Open for now, secure via API layer
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
