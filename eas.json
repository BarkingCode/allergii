{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "dev-sim": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development-simulator"
    },
    "prev": {
      "distribution": "internal",
      "channel": "preview"
    },
    "prod": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "prod": {}
  }
}
